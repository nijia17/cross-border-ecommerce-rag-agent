# ===== 大模型 API（以 DeepSeek 为例，OpenAI 兼容协议，可替换为通义/智谱等）=====
# 复制本文件为 .env 并填入真实密钥；.env 已加入 .gitignore，不会被提交
DEEPSEEK_API_KEY=你的API密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1

# ===== 嵌入模型（本地 bge-small-zh-v1.5，默认无需密钥、无需联网）=====
# 留空则自动使用 HuggingFace 本地缓存中的 BAAI/bge-small-zh-v1.5
# 如需指定本地目录或别的模型，可取消下一行注释：
# BGE_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DEVICE=cpu

# ===== 阿里云百炼（通义）可选项：配置后优先使用在线 Embedding =====
# DASHSCOPE_API_KEY=你的通义密钥

# ===== 检索参数（可选调参）=====
RECALL_K=10
FINAL_TOP_K=3
SCORE_THRESHOLD=0.60
